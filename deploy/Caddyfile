# HTTPS-сертификат Let's Encrypt выпускается и продлевается автоматически.
{$DOMAIN} {
	encode zstd gzip
	# Файлы сборки с хешем в имени не меняются — кешируем надолго
	@static path /_next/static/* /images/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
