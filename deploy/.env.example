# Переменные сервера. Скопируйте в /opt/lola-stl/.env и заполните.

# --- Сервер ---
DOMAIN=lola-stl.ru                       # домен, на который смотрит A-запись DNS
SITE_URL=https://lola-stl.ru
POSTGRES_PASSWORD=                       # openssl rand -base64 24
APP_IMAGE=ghcr.io/h5xde-dev/lola-stl:latest

# --- Обязательно ---
AUTH_SECRET=                             # openssl rand -base64 32
ADMIN_PASSWORD=

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1

# --- Файлы моделей (S3) ---
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://s3.twcstorage.ru     # Timeweb Cloud; для Yandex — https://storage.yandexcloud.net
S3_REGION=ru-1

# --- Почта и Telegram ---
SMTP_URL=
MAIL_FROM=lola.stl <shop@lola-stl.ru>
TELEGRAM_BOT_TOKEN=

# --- SEO и вид ---
INDEXING=
DEMO=off
SAME_AS=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
