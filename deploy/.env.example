# Переменные сервера. Скопируйте в /opt/lola-stl/.env и заполните.

# --- Сервер ---
DOMAIN=lola-stl.ru                       # домен, на который смотрит A-запись DNS
SITE_URL=https://lola-stl.ru
POSTGRES_PASSWORD=                       # openssl rand -base64 24
APP_IMAGE=ghcr.io/h5xde-dev/lola-stl:latest

# --- Обязательно ---
AUTH_SECRET=                             # openssl rand -base64 32
ADMIN_LOGIN=                             # логин владелицы для входа в админку
ADMIN_PASSWORD=                          # длинный случайный пароль

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1

# --- Файлы моделей (S3) ---
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://s3.twcstorage.ru     # Timeweb Cloud; для Yandex — https://storage.yandexcloud.net
S3_REGION=ru-1

# --- Почта и Telegram ---
# Почта: Unisender Go по API (работает, даже если хостинг закрыл порты 465/587) или SMTP
UNISENDER_API_KEY=                       # обычный Unisender: ключ API (адрес MAIL_FROM подтвердить в Unisender)
UNISENDER_LIST_ID=                       # список для строки отписки; пусто — первый список аккаунта
UNISENDER_GO_API_KEY=                    # или Unisender Go: ключ API из личного кабинета Unisender Go
UNISENDER_GO_HOST=go1.unisender.ru       # go1 или go2 — как в адресе личного кабинета
SMTP_URL=                                # или SMTP, например smtps://ящик%40yandex.ru:пароль-приложения@smtp.yandex.ru:465
MAIL_FROM=lola.stl <shop@greennessx.ru> # адрес на подтверждённом в Unisender домене (для Яндекса — сам ящик)
MAIL_REPLY_TO=                           # куда отвечают покупатели, например greennessx@yandex.ru
TELEGRAM_BOT_TOKEN=

# --- SEO и вид ---
INDEXING=
DEMO=off
SAME_AS=
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
S3_FORCE_PATH_STYLE=true                 # адреса вида endpoint/bucket; false — для хранилищ, где нужен bucket.endpoint

# Тестовая оплата на рабочем сервере (без ЮKassa). Не включайте при настоящих продажах.
ALLOW_TEST_PAYMENTS=
