# Скопируйте в .env.local (локально) или задайте в Vercel → Settings → Environment Variables.
# Без этих переменных сайт работает в режиме проверки: встроенная база, тестовая оплата, письма только в журнале.

# --- Обязательно для рабочего сайта ---
SITE_URL=https://lola-stl.ru                    # основной адрес сайта (для ссылок в письмах и возврата после оплаты)
AUTH_SECRET=                                     # длинная случайная строка: openssl rand -base64 32
ADMIN_PASSWORD=                                  # пароль владелицы для /admin
DATABASE_URL=                                    # Postgres: Neon, Supabase или Yandex Managed PostgreSQL

# --- Оплата: ЮKassa (личный кабинет → Интеграция → Ключи API) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1                              # 1 — без НДС (ИП на УСН); уточните у бухгалтера

# --- Файлы моделей: S3-совместимое хранилище (Yandex Object Storage, Selectel) ---
S3_BUCKET=                                       # закрытый бакет, без публичного доступа
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1

# --- Почта: ссылки на покупки ---
SMTP_URL=                                        # smtps://логин:пароль@smtp.yandex.ru:465 или сервис рассылок
MAIL_FROM=lola.stl <shop@lola-stl.ru>

# --- Telegram: вход в Mini App и сообщения после оплаты ---
TELEGRAM_BOT_TOKEN=                              # от @BotFather

# --- SEO (необязательно) ---
INDEXING=                                        # on — открыть сайт для поисковиков
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
SAME_AS=                                         # ссылки на соцсети через запятую
DEMO=                                            # off — скрыть верхнюю панель прототипа
